<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>finance.idem</groupId>
        <artifactId>idem</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>infrastructure</artifactId>
    <name>idem-infrastructure</name>
    <description>External adapters — Spring Data JPA, Kafka, chain libs, Flyway</description>

    <dependencies>
        <dependency>
            <groupId>finance.idem</groupId>
            <artifactId>application</artifactId>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Security — SecurityFilterChain permits /internal/**, ApiKeyAuthFilter (M2-3) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Micrometer context propagation — propagates SecurityContextHolder across Reactor threads
             used by McpReactorSecurityConfig to bridge MCP async tool dispatch with our auth -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>

        <!-- Spring Web MVC — needed for OncePerRequestFilter (ApiKeyAuthFilter) and WebSecurityConfig -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation — @NotBlank on @ConfigurationProperties (e.g. AuditProperties) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Metrics — MeterRegistry for chain dead-letter alerting (idem.chain.dead_letter) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Redis — API key cache (5-min TTL, prefix lookup) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- JSON — JSONB serialization for MonetaryEntry, AgentContext, metadata -->
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- EVM chain reader — Web3j -->
        <dependency>
            <groupId>org.web3j</groupId>
            <artifactId>core</artifactId>
            <version>${web3j.version}</version>
        </dependency>

        <!-- ShedLock — distributed lock for @Scheduled tasks across multi-replica deployments (#89) -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>${shedlock.version}</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.tomakehurst</groupId>
            <artifactId>wiremock-jre8-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito.kotlin</groupId>
            <artifactId>mockito-kotlin</artifactId>
            <version>5.4.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <!-- JPA @Entity data model classes — Kotlin-generated copy/equals/hashCode
                         synthetic bytecode produces unexercisable branches -->
                    <excludes>
                        <exclude>finance/idem/infrastructure/persistence/audit/AuditLogDataModel*</exclude>
                        <exclude>finance/idem/infrastructure/persistence/outbox/WebhookOutboxDataModel*</exclude>
                        <exclude>finance/idem/infrastructure/persistence/idempotency/IdempotencyKeyDataModel*</exclude>
                        <exclude>finance/idem/infrastructure/persistence/chain/ChainCheckpointDataModel*</exclude>
                        <exclude>finance/idem/infrastructure/persistence/chain/WatchedAddressDataModel*</exclude>
                        <exclude>finance/idem/infrastructure/persistence/chain/FailedChainTransferDataModel*</exclude>
                        <!-- Kotlin data classes — generated copy$default synthetic branches -->
                        <exclude>finance/idem/infrastructure/chain/EvmChainConfig*</exclude>
                        <exclude>finance/idem/infrastructure/chain/EvmNetworkConfig*</exclude>
                        <exclude>finance/idem/infrastructure/chain/SolanaNetworkConfig*</exclude>
                        <exclude>finance/idem/infrastructure/chain/WatchedAddress*</exclude>
                        <exclude>finance/idem/infrastructure/chain/DetectedTransfer*</exclude>
                        <!-- SolanaChainReader inner data classes — Kotlin-generated synthetic bytecode -->
                        <exclude>finance/idem/infrastructure/chain/SolanaChainReader$*</exclude>
                        <!-- AlchemyWebhookPayload data classes — Kotlin-generated synthetic branches -->
                        <exclude>finance/idem/infrastructure/chain/AlchemyWebhookPayload*</exclude>
                        <exclude>finance/idem/infrastructure/chain/AlchemyWebhookEvent*</exclude>
                        <exclude>finance/idem/infrastructure/chain/AlchemyActivity*</exclude>
                        <exclude>finance/idem/infrastructure/chain/AlchemyRawContract*</exclude>
                        <exclude>finance/idem/infrastructure/chain/AlchemyLog*</exclude>
                        <!-- QuickNodeWebhookPayload / QuickNodeStreamPayload data classes — Kotlin-generated synthetic branches -->
                        <exclude>finance/idem/infrastructure/chain/QuickNodeWebhookPayload*</exclude>
                        <exclude>finance/idem/infrastructure/chain/QuickNodeStreamPayload*</exclude>
                        <exclude>finance/idem/infrastructure/chain/QuickNodeStreamMetadata*</exclude>
                        <!-- TronChainReader inner data classes — Kotlin-generated synthetic bytecode -->
                        <exclude>finance/idem/infrastructure/chain/TronChainReader$*</exclude>
                        <!-- TronNetworkConfig — Kotlin data class synthetic branches -->
                        <exclude>finance/idem/infrastructure/chain/TronNetworkConfig*</exclude>
                        <!-- AuditProperties — Kotlin data class synthetic branches -->
                        <exclude>finance/idem/infrastructure/persistence/audit/AuditProperties*</exclude>
                        <!-- WebSecurityConfig — pure Spring Security wiring, no business logic;
                             @ConditionalOnWebApplication(SERVLET) means it never loads in infra tests -->
                        <exclude>finance/idem/infrastructure/security/WebSecurityConfig*</exclude>
                        <!-- InstallationMetadataDataModel — JPA no-arg constructor synthetic branches -->
                        <exclude>finance/idem/infrastructure/persistence/telemetry/InstallationMetadataDataModel*</exclude>
                        <!-- Workflow / agent audit JPA data models — Kotlin-generated no-arg constructor synthetic branches -->
                        <exclude>finance/idem/infrastructure/persistence/workflow/WorkflowPlanDataModel*</exclude>
                        <exclude>finance/idem/infrastructure/persistence/workflow/WorkflowPlanStepDataModel*</exclude>
                        <exclude>finance/idem/infrastructure/persistence/audit/AgentAuditEventDataModel*</exclude>
                        <!-- MCP SSE session auth bridge — ServletOutputStream adapter boilerplate:
                             write(int), isReady(), setWriteListener() are unconditional delegates
                             required by the abstract class contract; not exercisable in unit tests. -->
                        <exclude>finance/idem/infrastructure/security/SessionCapturingResponseWrapper*</exclude>
                        <exclude>finance/idem/infrastructure/security/SessionCapturingOutputStream*</exclude>
                        <exclude>finance/idem/infrastructure/security/McpSseAuthBridgeFilterKt*</exclude>
                        <!-- SecurityContextAccessor — ThreadLocalAccessor plumbing: getValue/setValue/reset
                             delegate unconditionally to SecurityContextHolder; not the right layer to test -->
                        <exclude>finance/idem/infrastructure/security/SecurityContextAccessor*</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
