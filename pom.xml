<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.15</version>
        <relativePath/>
    </parent>

    <groupId>finance.idem</groupId>
    <artifactId>idem</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>idem</name>
    <description>Open-source event-sourced double-entry ledger for cross-border stablecoin payments</description>

    <licenses>
        <license>
            <name>Functional Source License, Version 1.1, Apache 2.0 Future License</name>
            <url>https://fsl.software/FSL-1.1-Apache-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>ifsantana</id>
            <name>ifsantana</name>
            <email>flaubert165@gmail.com</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git://github.com/idem-finance/idem.git</connection>
        <developerConnection>scm:git:ssh://github.com/idem-finance/idem.git</developerConnection>
        <url>https://github.com/idem-finance/idem</url>
    </scm>

    <modules>
        <module>core</module>
        <module>application</module>
        <module>infrastructure</module>
        <module>api</module>
        <module>mcp</module>
        <module>app</module>
        <module>sdk-kotlin</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <kotlin.version>1.9.25</kotlin.version>
        <spring-modulith.version>1.4.11</spring-modulith.version>
        <springdoc.version>2.8.9</springdoc.version>
        <jacoco.version>0.8.13</jacoco.version>
        <jacoco.minimum.coverage>0.80</jacoco.minimum.coverage>
        <web3j.version>4.12.0</web3j.version>
        <wiremock.version>2.35.1</wiremock.version>
        <shedlock.version>6.6.0</shedlock.version>
        <dokka.version>1.9.20</dokka.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>1.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Internal module versions — child poms omit <version> -->
            <dependency>
                <groupId>finance.idem</groupId>
                <artifactId>core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>finance.idem</groupId>
                <artifactId>application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>finance.idem</groupId>
                <artifactId>infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>finance.idem</groupId>
                <artifactId>api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>finance.idem</groupId>
                <artifactId>mcp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>finance.idem</groupId>
                <artifactId>idem-sdk-kotlin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Inherited by all modules: only the Kotlin runtime, nothing else -->
    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <!--
                                      Excludes use dot-notation for class names.
                                      Spring Boot entry point: not unit-testable by design.
                                      @JvmInline value classes: JVM erases the box type so JaCoCo
                                      can never observe the box class being instantiated — the
                                      companion and all usage IS tested, this is a tool limitation.
                                    -->
                                    <excludes>
                                        <exclude>finance.idem.IdemApplication</exclude>
                                        <exclude>finance.idem.IdemApplicationKt</exclude>
                                        <exclude>finance.idem.TestIdemApplication</exclude>
                                        <exclude>finance.idem.TestcontainersConfiguration</exclude>
                                        <!-- Dev-only seed runner — calls exitProcess, not unit-testable by design. -->
                                        <exclude>finance.idem.DevDataSeeder</exclude>
                                        <exclude>finance.idem.core.AccountId</exclude>
                                        <exclude>finance.idem.core.TransactionId</exclude>
                                        <exclude>finance.idem.core.TenantId</exclude>
                                        <exclude>finance.idem.core.WorkflowPlanId</exclude>
                                        <exclude>finance.idem.core.security.ApiKeyId</exclude>
                                        <!--
                                          Kotlin inline extension functions (e.g. ObjectMapper.readValue<T>)
                                          generate synthetic anonymous classes that JaCoCo cannot instrument.
                                          Pattern matches e.g. TransactionRepositoryAdapterKt$..inlined..1
                                        -->
                                        <exclude>*..inlined..*</exclude>
                                        <!--
                                          Kotlin data class DTOs — generated copy$default synthetic
                                          methods contain unexercisable bytecode branches.
                                          Previously inner classes excluded via MonetaryEntryRequestDto$*
                                          in api/pom.xml; now top-level classes, listed here.
                                        -->
                                        <exclude>finance.idem.api.ledger.FiatEntryDto</exclude>
                                        <exclude>finance.idem.api.ledger.OnChainEntryDto</exclude>
                                        <exclude>finance.idem.api.ledger.JournalLineRequestDto</exclude>
                                        <!-- Kotlin data class DTOs in api.security -->
                                        <exclude>finance.idem.api.security.CreateApiKeyRequest</exclude>
                                        <exclude>finance.idem.api.security.CreateApiKeyResponse</exclude>
                                        <!-- Kotlin data class — generated copy$default synthetic
                                             methods contain unexercisable bytecode branches. -->
                                        <exclude>finance.idem.core.security.ValidatedApiKey</exclude>
                                        <!-- Kotlin data class (16 fields) — generated copy$default/componentN
                                             synthetic methods contain unexercisable bytecode branches. -->
                                        <exclude>finance.idem.core.chain.FailedChainTransfer</exclude>
                                        <!--
                                          JPA @Entity classes — protected no-arg constructor required
                                          by JPA is called by the ORM at runtime, never in unit tests.
                                          Same pattern as AuditLogDataModel and WebhookOutboxDataModel
                                          (excluded via agent config in infrastructure/pom.xml).
                                        -->
                                        <exclude>finance.idem.infrastructure.persistence.idempotency.IdempotencyKeyDataModel</exclude>
                                        <exclude>finance.idem.infrastructure.persistence.chain.ChainCheckpointDataModel</exclude>
                                        <exclude>finance.idem.infrastructure.persistence.chain.FailedChainTransferDataModel</exclude>
                                        <!-- Kotlin data class request/response DTOs in api.reconciliation -->
                                        <exclude>finance.idem.api.reconciliation.ReconcileBatchRequest</exclude>
                                        <exclude>finance.idem.api.reconciliation.ReconcileBatchItemResponse</exclude>
                                        <!-- Kotlin data class request/response DTOs — copy$default synthetic
                                             methods generate unexercisable bytecode branches. -->
                                        <exclude>finance.idem.api.tenant.UpdateWebhookConfigRequest</exclude>
                                        <exclude>finance.idem.api.tenant.WebhookConfigCreatedResponse</exclude>
                                        <!-- MCP input DTO (14 fields, 11 optional) — copy$default synthetic
                                             method for 11 optional params contains unexercisable bitmask branches;
                                             same pattern as FiatEntryDto / OnChainEntryDto above. -->
                                        <exclude>finance.idem.mcp.McpJournalLineInput</exclude>
                                        <exclude>finance.idem.api.tenant.WebhookConfigResponse</exclude>
                                        <!--
                                          Kotlin interface DefaultImpls — generated by the Kotlin compiler
                                          for every interface to support Java interoperability. Contains
                                          no application logic; never executed directly.
                                        -->
                                        <exclude>*.DefaultImpls</exclude>
                                        <!--
                                          Kotlin companion object holding a const val — the compiler accesses
                                          companion val properties via a static bridge method on the outer
                                          class, so the Companion class getter is never invoked directly.
                                          Coverage is provided by tests that use DEFAULT_THRESHOLD;
                                          the 0% report is a JaCoCo + Kotlin bytecode artifact.
                                        -->
                                        <exclude>finance.idem.core.compliance.TravelRuleData.Companion</exclude>
                                    </excludes>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                    </args>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                        <plugin>jpa</plugin>
                        <plugin>all-open</plugin>
                    </compilerPlugins>
                    <pluginOptions>
                        <option>all-open:annotation=jakarta.persistence.Entity</option>
                        <option>all-open:annotation=jakarta.persistence.MappedSuperclass</option>
                        <option>all-open:annotation=jakarta.persistence.Embeddable</option>
                    </pluginOptions>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-noarg</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Activated explicitly with -P release. Signs all module artifacts
          with GPG before publishing to Maven Central.
          Requires GPG key in keyring and MAVEN_GPG_PASSPHRASE env var set.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- Required in CI: reads passphrase from MAVEN_GPG_PASSPHRASE
                                 env var without opening a pinentry dialog. -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
