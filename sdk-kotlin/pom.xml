<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>finance.idem</groupId>
        <artifactId>idem</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>idem-sdk-kotlin</artifactId>
    <name>idem-sdk-kotlin</name>
    <description>Standalone Kotlin HTTP client SDK for the Idem ledger REST API — depends on
    nothing else in this repo, published independently to Maven Central</description>

    <properties>
        <!-- Ktor 3.x requires Kotlin 2.0+; this repo pins kotlin.version=1.9.25, so Ktor
             stays on the 2.3.x line. -->
        <ktor.version>2.3.13</ktor.version>
        <kotlinx-coroutines.version>1.7.3</kotlinx-coroutines.version>
    </properties>

    <!--
        No dependency on core/application/infrastructure/api/mcp/app — this module is a
        standalone HTTP client published independently to Maven Central. Ktor client artifacts
        are Kotlin-Multiplatform-published; the "-jvm" suffix selects the JVM-only jar.
    -->
    <dependencies>
        <dependency>
            <groupId>io.ktor</groupId>
            <artifactId>ktor-client-core-jvm</artifactId>
            <version>${ktor.version}</version>
        </dependency>
        <dependency>
            <groupId>io.ktor</groupId>
            <artifactId>ktor-client-cio-jvm</artifactId>
            <version>${ktor.version}</version>
        </dependency>
        <dependency>
            <groupId>io.ktor</groupId>
            <artifactId>ktor-client-content-negotiation-jvm</artifactId>
            <version>${ktor.version}</version>
        </dependency>
        <dependency>
            <groupId>io.ktor</groupId>
            <artifactId>ktor-serialization-jackson-jvm</artifactId>
            <version>${ktor.version}</version>
        </dependency>

        <!-- Versions managed by the inherited spring-boot-starter-parent BOM -->
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-core-jvm</artifactId>
            <version>${kotlinx-coroutines.version}</version>
        </dependency>

        <!-- Test: Ktor MockEngine — no real server needed -->
        <dependency>
            <groupId>io.ktor</groupId>
            <artifactId>ktor-client-mock-jvm</artifactId>
            <version>${ktor.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-test-jvm</artifactId>
            <version>${kotlinx-coroutines.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Activated with -P release during the publish-sdk CI job.
          Attaches sources and Dokka javadoc JARs (both required by Maven Central),
          then deploys to the Central Portal via the central-publishing-maven-plugin.
          Credentials come from the 'central' server entry in ~/.m2/settings.xml
          (injected by setup-java@v4 in CI using SONATYPE_USERNAME/SONATYPE_PASSWORD secrets).
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.6.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.jetbrains.dokka</groupId>
                        <artifactId>dokka-maven-plugin</artifactId>
                        <version>${dokka.version}</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals><goal>javadocJar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Sealed request/response hierarchies (MonetaryEntryRequest/Response and
                             their FIAT/ONCHAIN subtypes) — Kotlin-generated copy$default synthetic
                             methods produce unexercisable bytecode branches. -->
                        <exclude>finance/idem/sdk/model/MonetaryEntryRequest*</exclude>
                        <exclude>finance/idem/sdk/model/MonetaryEntryResponse*</exclude>
                        <exclude>finance/idem/sdk/model/FiatEntryRequest*</exclude>
                        <exclude>finance/idem/sdk/model/OnChainEntryRequest*</exclude>
                        <exclude>finance/idem/sdk/model/FiatEntryResponse*</exclude>
                        <exclude>finance/idem/sdk/model/OnChainEntryResponse*</exclude>

                        <!-- Flat Kotlin data-class DTOs — generated copy$default/component*/equals/
                             hashCode/toString synthetic methods produce unexercisable bytecode
                             branches. -->
                        <exclude>finance/idem/sdk/model/BalanceResponse*</exclude>
                        <exclude>finance/idem/sdk/model/StatementMovementResponse*</exclude>
                        <exclude>finance/idem/sdk/model/EntriesPage*</exclude>
                        <exclude>finance/idem/sdk/model/JournalLineResponse*</exclude>
                        <exclude>finance/idem/sdk/model/StatementResponse*</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
